# Copy to .env.production on the EC2 instance and fill in real values. NEVER commit .env.production.
NODE_ENV=production
PORT=4000

# MongoDB Atlas (rotate the password before go-live; scope a dedicated app user)
MONGODB_URI=mongodb+srv://<appuser>:<password>@cluster0.w432kli.mongodb.net/
CRM_DB=test
APP_DB=kb360_app

# JWT — generate NEW random 32+ char secrets (do not reuse dev)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=365d

# Push (Expo) — real delivery
EXPO_PUSH_ENABLED=true

# File storage — use S3 in production (local disk is lost on redeploy)
STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# (or STORAGE_DRIVER=local + STORAGE_LOCAL_DIR=/app/uploads)

# Microsoft 365 email (from IT's Azure app registration)
MS_CLIENT_ID=
MS_TENANT_ID=
EMAIL_TOKEN_KEY=         # 32-byte hex; keep STABLE (rotating it invalidates stored refresh tokens)

# Firebase Admin (native full-screen call UI). Mount the key at this path (see docker-compose.prod.yml)
# FIREBASE_SERVICE_ACCOUNT=/app/secrets/firebase.json

# Audio calls across networks — run coturn and fill these (see DEPLOY_EC2.md)
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:13.127.43.110:3478
# TURN_USERNAME=
# TURN_PASSWORD=
CALL_RING_TIMEOUT_SEC=45

# System-alert ingest (ERP/CRM → app). Shared secret; the SAME value goes in the ERP and CRM
# backends' MOBILE_ALERTS_TOKEN. Generate with: openssl rand -hex 32. Unset = ingest disabled.
ALERTS_INGEST_TOKEN=
