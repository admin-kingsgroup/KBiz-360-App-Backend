# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://kb360:kb360@localhost:5432/kb360?schema=public"

# --- App ---
PORT=4000
NODE_ENV=development

# --- Auth (JWT) — REQUIRED. Generate two DIFFERENT random secrets, 32+ chars each.
# The server refuses to start if either is missing, empty, too short, or a placeholder.
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="365d"

# --- Redis / BullMQ (queue, push delivery) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Uploads (storage adapter) ---
STORAGE_DRIVER=local            # local | s3  (set to s3 in production)
STORAGE_LOCAL_DIR=./uploads
# S3_BUCKET=kb360-media
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=             # omit if the EC2 instance has an IAM role with s3:PutObject
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=          # optional: a CloudFront/custom domain; else the S3 URL is used

# --- Email (Resend) — wired in Notifications phase ---
# RESEND_API_KEY=

# --- Expo Push (Notifications) ---
EXPO_PUSH_ENABLED=false        # false = dry-run (no real delivery); true = POST to Expo push API
# EXPO_ACCESS_TOKEN=

# --- MongoDB (Mongo backend: src/mongo/main.ts, `npm run start:mongo`) ---
MONGODB_URI=                   # mongodb+srv://... app user: readWrite kb360_app, READ-ONLY on CRM_DB (see DB_LEAST_PRIVILEGE.md)
CRM_DB=test                    # READ-ONLY source database (CRM/ERP)
APP_DB=kb360_app               # app-owned writes: sessions, call_logs, active_calls, push_devices
CRM_WRITE_MONGODB_URI=         # OPTIONAL: separate connection for sanctioned CRM provisioning writes; unset = fall back to MONGODB_URI

# --- Audio Calling (WebRTC ICE servers) ---
# STUN is always used. TURN is optional but required for calls across strict/symmetric NATs.
# Provision your own coturn server and fill these in — never commit real credentials.
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:your-coturn-host:3478
# TURN_USERNAME=
# TURN_PASSWORD=
CALL_RING_TIMEOUT_SEC=45        # auto mark a ringing call as missed after this many seconds

# System-alert ingest (ERP/CRM → app). Shared secret; same value as the emitters' MOBILE_ALERTS_TOKEN.
ALERTS_INGEST_TOKEN=
